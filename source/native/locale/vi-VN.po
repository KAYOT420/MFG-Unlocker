msgstr "Hiệu năng"

msgid "Balanced"
msgstr "Cân bằng"

msgid "Quality"
msgstr "Chất lượng"

msgid "Ultra Performance"
msgstr "Hiệu năng cực cao"

msgid "Ultra Quality"
msgstr "Chất lượng cực cao"

