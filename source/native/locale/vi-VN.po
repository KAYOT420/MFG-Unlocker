msgid ""
"Follow game uses the game's own frame generation setting.\n"
"Dynamic adjusts frame generation toward a target frame rate; it does not set a hard FPS limit."
msgstr ""
"\"Theo game\" sẽ dùng thiết lập Frame Gen mặc định của game.\n"
"\"Dynamic\" tự điều chỉnh số frame nội suy để đạt mức FPS mục tiêu; không phải là giới hạn FPS cứng."

msgid "Dynamic target"
msgstr "Mục tiêu Dynamic"

msgid "Display refresh rate"
msgstr "Tần số quét màn hình (Hz)"

msgid "Target FPS"
msgstr "FPS mục tiêu"

msgid "Dynamic MFG is unavailable with the current limit or runtime. Its full frame-generation range must fit the limit."
msgstr "Dynamic MFG không khả dụng với mức giới hạn hoặc runtime hiện tại. Toàn bộ dải tạo khung hình phải nằm gọn trong giới hạn này."

msgid "Dynamic selection is saved; waiting for runtime support."
msgstr "Đã lưu tùy chọn Dynamic; đang chờ runtime hỗ trợ."

msgid "Saved MFG request: %dx (unavailable in this session)"
msgstr "Mức MFG đã lưu: %dx (không khả dụng trong phiên này)"

msgid "Request accepted, but the configuration was not saved."
msgstr "Đã nhận yêu cầu, nhưng chưa lưu cấu hình."

msgid "The selection could not be applied or saved."
msgstr "Không thể áp dụng hoặc lưu tùy chọn đã chọn."

msgid "Latency and display"
msgstr "Độ trễ và hiển thị"

msgid "DLSS Ray Reconstruction"
msgstr "DLSS Ray Reconstruction"

msgid "DLSS Super Resolution"
msgstr "DLSS Super Resolution"

