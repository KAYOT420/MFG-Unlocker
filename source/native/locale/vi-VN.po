msgid "NVIDIA list unavailable"
msgstr "Danh sách NVIDIA không khả dụng"

msgid "NVIDIA lists no MFG for this game"
msgstr "NVIDIA không hỗ trợ MFG cho game này"

msgid "game not on NVIDIA's list"
msgstr "game không có trong danh sách của NVIDIA"

msgid "NVIDIA lists %ux"
msgstr "Danh sách NVIDIA: %ux"

msgid "Limit"
msgstr "Giới hạn"

msgid "the current wrapper has no verified MFG override"
msgstr "wrapper hiện tại chưa có override MFG được xác thực"

msgid "%dx (safe fallback)"
msgstr "%dx (chế độ an toàn)"

msgid "Waiting"
msgstr "Đang chờ"

msgid "for an active DLSS-G wrapper"
msgstr "wrapper DLSS-G đang hoạt động"

msgid "NVIDIA lists ordinary Frame Generation only. The mod keeps its override limit at 2x."
msgstr "NVIDIA chỉ ghi nhận Frame Generation thường. Mod sẽ giữ mức override tối đa ở 2x."

msgid "The listed %ux ceiling requires a compatible runtime. The current limit is %dx."
msgstr "Mức trần %ux trên danh sách cần có runtime tương thích. Mức giới hạn hiện tại là %dx."

msgid ""
"The highest mode the current DLSS-G runtime supports, and the ceiling\n"
"NVIDIA's override list gives this game."
msgstr ""
"Chế độ cao nhất mà runtime DLSS-G hiện tại hỗ trợ, cùng với mức trần\n"
"mà danh sách override của NVIDIA cấp cho game này."

msgid "%.1f real, %.1f DLSS"
msgstr "%.1f thực, %.1f DLSS"

msgid "%.1f real, DLSS unavailable"
msgstr "%.1f thực, DLSS không khả dụng"

msgid "Measuring..."
msgstr "Đang đo..."

msgid "DLSS FG off"
msgstr "DLSS FG tắt"

msgid "waiting for an accepted Dynamic request"
msgstr "đang chờ áp dụng lệnh Dynamic"

msgid "applied: display refresh rate"
msgstr "đã áp dụng: theo tần số quét màn hình"

msgid "applied: %.2f FPS"
msgstr "đã áp dụng: %.2f FPS"

msgid "Restart with the matching single-module build. The current status protocol is older than this UI expects."
msgstr "Hãy restart game với bản build đơn module phù hợp. Giao thức trạng thái hiện tại cũ hơn phiên bản giao diện cần."

msgid "Frame generation stays under the game's control. This wrapper has no verified MFG override support."
msgstr "Frame Generation vẫn do game kiểm soát. Wrapper này chưa hỗ trợ override MFG chính thức."

msgid "DLSS-G activity observed; waiting for the game's FG control calls."
msgstr "Đã phát hiện DLSS-G hoạt động; đang chờ lệnh điều khiển FG từ game."

msgid "Waiting for the game to request frame generation."
msgstr "Đang chờ game yêu cầu bật Frame Generation."

msgid "Waiting for an active DLSS-G pipeline."
msgstr "Đang chờ pipeline DLSS-G hoạt động."

msgid "Toggle frame generation off then on, or restart the game, to recreate the pipeline with this selection."
msgstr "Bật tắt lại Frame Generation hoặc khởi động lại game để tạo lại pipeline với thiết lập mới này."

msgid "Diagnostics"
msgstr "Chẩn đoán"

