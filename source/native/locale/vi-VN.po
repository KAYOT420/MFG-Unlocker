msgstr "XeMFG cần libxess_fg.dll và libxell.dll trong thư mục RTXMFG-XeSS cạnh MFG Unlocker."

msgid "XeMFG needs libxess_fg.dll and libxell.dll together in %s (or beside the game's exe in %s). Restart the game after adding them."
msgstr "XeMFG cần libxess_fg.dll và libxell.dll cùng nằm trong %s (hoặc cạnh tệp exe của game trong %s). Hãy khởi động lại game sau khi thêm chúng."

msgid "Only libxell.dll was found."
msgstr "Chỉ tìm thấy libxell.dll."

msgid "Only libxess_fg.dll was found."
msgstr "Chỉ tìm thấy libxess_fg.dll."

msgid "The two files are in different folders."
msgstr "Hai tệp nằm ở hai thư mục khác nhau."

msgid "Found %s, not %s: check the file's name and extension."
msgstr "Tìm thấy %s, không phải %s: hãy kiểm tra tên và phần mở rộng của tệp."

