msgstr "Бекенд %s не завантажено."

msgid "The integrated core is unavailable. Check the startup log and restart the game with one %s module."
msgstr "Вбудоване ядро недоступне. Перевірте журнал запуску й перезапустіть гру лише з одним модулем %s."

msgid "Paused"
msgstr "Призупинено"

