msgstr "Працює"

msgid "The game changed graphics adapters. Restart the game to select a new GPU."
msgstr "Гра змінила графічний адаптер. Перезапустіть гру, щоб перейти на новий GPU."

msgid "RTX Remix detected. Frame generation and its multiplier are managed in the RTX Remix menu."
msgstr "Виявлено RTX Remix. Генерація кадрів та її множник налаштовуються в меню RTX Remix."

msgid "Provider patch"
msgstr "Патч провайдера"

msgid "Ready at feature creation"
msgstr "Готово на момент створення функції"

msgid "Waiting for frame generation"
msgstr "Очікування генерації кадрів"

msgid "Restart with the matching single-module build. The current status protocol is older than this UI expects."
msgstr "Перезапустіть гру з відповідною однофайловою збіркою. Поточний протокол стану старіший, ніж очікує цей інтерфейс."

msgid "5x MFG (experimental)"
msgstr "5x MFG (експериментально)"

